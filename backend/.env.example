# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Groq (OpenAI-compatible API). Also used automatically if OpenAI fails, e.g. 429 insufficient_quota.
GROQ_API_KEY=your_groq_api_key_here

# Which provider runs synthesis/thesis/pitch first: openai (default) or groq. Gemini is the last-resort fallback.
LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=openai/gpt-oss-120b   (llama-3.3-70b-versatile is no longer offered by Groq)

# Optional: GitHub Personal Access Token to increase API rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=

# Server Configuration
PORT=8000
HOST=0.0.0.0
